#: appearance.cpp:113
msgid "Und&erline links:"
msgstr "Bogʻlarni t&agini chizish:"

#: appearance.cpp:116
#, fuzzy
#| msgid ""
#| "Controls how Konqueror handles underlining hyperlinks:"
#| "<br><ul><li><b>Enabled</b>: Always underline links</li><li><b>Disabled</"
