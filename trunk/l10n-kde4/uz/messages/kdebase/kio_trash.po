#: ktrash.cpp:34
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:36
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kfmclient move "
"'url' trash:/\""
msgstr ""
"KDE uchun chiqindilar qutisini boshqaradigan dastur.\n"
"Izoh: Faylni chiqindilar qutisiga koʻchirish uchun ktrash buyrugʻini ishlatmang, "
"buni quyidagicha bajarsa boʻladi. \"kfmclient move 'url' trash:/\""

#: ktrash.cpp:40
msgid "Empty the contents of the trash"
msgstr "Chiqindilar qutisini boʻshatish"

#: ktrash.cpp:42
msgid "Restore a trashed file to its original location"
msgstr "Faylni asl joyiga tiklash"

#: ktrash.cpp:44
msgid "Ignored"
msgstr "Eʼtibor berilmadi"

#: kio_trash.cpp:52
msgid "Protocol name"
msgstr "Protokolning nomi"

#: kio_trash.cpp:53 kio_trash.cpp:54
msgid "Socket name"
msgstr "Soketning nomi"

#: kio_trash.cpp:102 kio_trash.cpp:165 kio_trash.cpp:313 kio_trash.cpp:345
#: kio_trash.cpp:511 kio_trash.cpp:523
#, kde-format
msgid "Malformed URL %1"
msgstr "Xato URL %1"

#: kio_trash.cpp:121
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Direktoriya '%1' mavjud emas. Faylni asl joyiga tiklab boʻlmaydi. Uni tiklash "
"uchun yuqorida aytilgan direktoriyani yarating yoki faylni boshqa joyga sichqoncha "
"bilan tortib tashlang."

#: kio_trash.cpp:150
msgid "This file is already in the trash bin."
msgstr "Fayl allaqachon chiqindilar qutisida."

