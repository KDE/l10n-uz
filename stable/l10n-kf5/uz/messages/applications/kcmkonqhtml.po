#: appearance.cpp:96
msgctxt "underline"
msgid "Enabled"
msgstr "Yoqilgan"

#: appearance.cpp:97
msgctxt "underline"
msgid "Disabled"
msgstr "Oʻchirilgan"

#: appearance.cpp:98
msgid "Only on Hover"
msgstr "Sichqoncha ustida turganda"

#: appearance.cpp:99
msgid "Und&erline links:"
msgstr "Bogʻlarni t&agini chizish:"

#: appearance.cpp:102
#, fuzzy
msgid ""
"<html>Controls how Konqueror handles underlining hyperlinks:<br /"
"><ul><li><b>Enabled</b>: Always underline links</li><li><b>Disabled</b>: "
"Never underline links</li><li><b>Only on Hover</b>: Underline when the mouse "
"is moved over the link</li></ul><br /><i>Note: The site's CSS definitions "
"can override this value.</i></html>"
msgstr ""
"Bu moslama bogʻlarning tagini chizishni Konqueror qanday boshqarishini "
"aniqlaydi:<br><ul><li><b>Yoqilgan</b>: Bogʻlarning tagini hamisha chizish</"
"li><li><b>Oʻchirilgan</b>: Bogʻlarning tagi hech qachon chizilmasin</"
"li><li><b>Sichqoncha ustida turganda</b>: Sichqoncha ustida turganda "
"bogʻlarning tagini chizish</li></ul><br><i>Izoh: Bu qiymatlarni saytning CSS "
"moslamalari almashtirishi mumkin</i>"

#: appearance.cpp:111
msgid "When Efficient"
msgstr ""

#: appearance.cpp:112
msgctxt "smooth scrolling"
msgid "Always"
msgstr ""

#: appearance.cpp:113
msgctxt "soft scrolling"
msgid "Never"
msgstr ""

#: appearance.cpp:114
msgid "S&mooth scrolling:"
msgstr ""

#: appearance.cpp:116
msgid ""
"<html>Determines whether Konqueror should use smooth steps to scroll HTML "
"pages, or whole steps:<br /><ul><li><b>Always</b>: Always use smooth steps "
"when scrolling.</li><li><b>Never</b>: Never use smooth scrolling, scroll "
"with whole steps instead.</li><li><b>When Efficient</b>: Only use smooth "
"scrolling on pages where it can be achieved with moderate usage of system "
"resources.</li></ul></html>"
msgstr ""

#: appearance.cpp:125
msgid ""
"<h1>Konqueror Fonts</h1>On this page, you can configure which fonts "
"Konqueror should use to display the web pages you view."
msgstr ""
"<h1>Konqueror shriftlari</h1>Bu yerda veb-sahifalarni koʻrsatishda Konqueror "
"ishlatadigan shriftlarni moslashingiz mumkin."

#: appearance.cpp:137
msgid "Font Si&ze"
msgstr "Shriftning oʻ&lchami"

#: appearance.cpp:140 appearance.cpp:158
msgid "This is the relative font size Konqueror uses to display web sites."
msgstr ""
"Konqueror veb-sahifalarni koʻrsatishda qoʻllaniladigan shriftlarning nisbiy "
"oʻlchami."

#: appearance.cpp:144
msgid "M&inimum font size:"
msgstr "Shriftning eng &kichik oʻlchami:"

#: appearance.cpp:148
#, fuzzy
msgid ""
"Konqueror will never display text smaller than this size,<br />overriding "
"any other settings."
msgstr ""
"Konqueror matnlarni bu yerda koʻrsatilgan shriftdan kichik shriftda "
"koʻrsatmaydi.<br>Bu moslama qolgan barcha moslamalarni oʻrniga ishlatiladi."

#: appearance.cpp:153
msgid "&Medium font size:"
msgstr "Shriftning oʻ&rtacha oʻlchami:"

#: appearance.cpp:166
msgid "S&tandard font:"
msgstr "&Andoza shrift:"

#: appearance.cpp:167
msgid "This is the font used to display normal text in a web page."
msgstr "Veb-sahifalardagi oddiy matnni koʻrsatish uchun shrift."

#: appearance.cpp:172
msgid "&Fixed font:"
msgstr "&Eni oʻzgarmaydigan shrift:"

#: appearance.cpp:173
msgid ""
"This is the font used to display fixed-width (i.e. non-proportional) text."
msgstr "Eni oʻzgarmaydigan harflar bilan yozilgan matn uchun shrift."

#: appearance.cpp:178
msgid "S&erif font:"
msgstr "Serif sh&rift:"

#: appearance.cpp:179
msgid "This is the font used to display text that is marked up as serif."
msgstr "Bu shrift Serif deb belgilangan matnni koʻrsatishda ishlatiladi."

#: appearance.cpp:185
msgid "Sa&ns serif font:"
msgstr "Sans serif shr&ift:"

#: appearance.cpp:186
msgid "This is the font used to display text that is marked up as sans-serif."
msgstr "Bu shrift Sans-serif deb belgilangan matnni koʻrsatishda ishlatiladi."

#: appearance.cpp:191
msgid "C&ursive font:"
msgstr "&Qiya shrift:"

#: appearance.cpp:192
msgid "This is the font used to display text that is marked up as italic."
msgstr "Bu shrift qiya deb belgilangan matnni koʻrsatishda ishlatiladi."

#: appearance.cpp:197
msgid "Fantas&y font:"
msgstr "Fantas&y shrift:"

#: appearance.cpp:198
msgid ""
"This is the font used to display text that is marked up as a fantasy font."
msgstr "Bu shrift Fantasy deb belgilangan matnni koʻrsatishda ishlatiladi."

#: appearance.cpp:209
msgid "Font &size adjustment for this encoding:"
msgstr "Ushbu kodlash usuli uchun shrift &oʻlchami:"

#: appearance.cpp:219 appearance.cpp:416
msgid "Use Language Encoding"
msgstr "Tilning kodlash usulini ishlatish"

#: appearance.cpp:221
msgid "Default encoding:"
msgstr "Andoza kodlash usuli:"

#: appearance.cpp:223
msgid ""
"Select the default encoding to be used; normally, you will be fine with 'Use "
"language encoding' and should not have to change this."
