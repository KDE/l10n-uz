#: filetemplates.cpp:513
msgid "Manage File Templates"
msgstr "Fayl namunalarini boshqarish"

#: filetemplates.cpp:531
msgid "&Template:"
msgstr "&Namuna:"

#: filetemplates.cpp:536
msgid ""
"<p>This string is used as the template's name and is displayed, for example, "
"in the Template menu. It should describe the meaning of the template, for "
"example 'HTML Document'.</p>"
msgstr ""

#: filetemplates.cpp:541
msgid "Press to select or change the icon for this template"
msgstr "Ushbu namuna uchun nishonchani oʻzgartirish yoki tanlash uchun bosing"

#: filetemplates.cpp:543
msgid "&Group:"
msgstr "&Guruh:"

#: filetemplates.cpp:547
msgid ""
"<p>The group is used for choosing a submenu for the plugin. If it is empty, "
"'Other' is used.</p><p>You can type any string to add a new group to your "
"menu.</p>"
msgstr ""

#: filetemplates.cpp:551
msgid "Document &name:"
msgstr "Hujjatning &nomi:"

#: filetemplates.cpp:554
msgid ""
"<p>This string will be used to set a name for the new document, to display "
"in the title bar and file list.</p><p>If the string contains '%N', that will "
"be replaced with a number increasing with each similarly named file.</p><p> "
"For example, if the Document Name is 'New shellscript (%N).sh', the first "
"document will be named 'New shellscript (1).sh', the second 'New shellscipt "
"(2).sh', and so on.</p>"
msgstr ""

#: filetemplates.cpp:562
msgid "&Highlight:"
msgstr ""

#: filetemplates.cpp:563
msgid "None"
msgstr "Yoʻq"

#: filetemplates.cpp:565
msgid ""
"<p>Select the highlight to use for the template. If 'None' is chosen, the "
"property will not be set.</p>"
msgstr ""

#: filetemplates.cpp:568
msgid "&Description:"
msgstr "&Taʼrifi:"

#: filetemplates.cpp:571
msgid ""
"<p>This string is used, for example, as context help for this template (such "
"as the 'whatsthis' help for the menu item.)</p>"
msgstr ""

#: filetemplates.cpp:575
msgid "&Author:"
msgstr "&Muallif:"

#: filetemplates.cpp:578
msgid ""
"<p>You can set this if you want to share your template with other users.</"
"p><p>the recommended form is like an Email address: 'Anders Lund &lt;"
"anders@alweb.dk&gt;'</p>"
msgstr ""

#: filetemplates.cpp:660
msgid "Start with an &empty document"
msgstr "&Boʻsh hujjat bilan boshlash"

#: filetemplates.cpp:665
msgid "Use an existing file:"
msgstr "Mavjud faylni ishlatish:"

#: filetemplates.cpp:675
msgid "Use an existing template:"
msgstr "Mavjud namunani ishlatish:"

#: filetemplates.cpp:707
msgid "Edit Template Properties"
msgstr "Namuna moslamasini tahrirlash"

#: filetemplates.cpp:708
msgid ""
"Specify the main properties of your plugin. You can leave fields empty for "
"which you have no meaningful value."
msgstr ""

#: filetemplates.cpp:730
msgid "Choose Location"
msgstr "Manzilini koʻrsatish"

#: filetemplates.cpp:731
msgid ""
"<p>Choose a location for the template. If you store it in the template "
"directory, it will automatically be added to the template menu.</p>"
msgstr ""

#: filetemplates.cpp:741
msgid "Template directory"
msgstr "Namuna jildi"

#: filetemplates.cpp:748
msgid "Template &file name:"
msgstr "Namuna &fayli nomi:"

#: filetemplates.cpp:753
msgid "Custom location:"
msgstr "Manzili:"

#: filetemplates.cpp:771
msgid "Autoreplace Macros"
msgstr "Avto-almashtirish makroslari"

#: filetemplates.cpp:772
msgid ""
"You can replace certain strings in the text with template macros. If any of "
"the data below is incorrect or missing, edit the data in the personal "
"kaddressbook entry."
msgstr ""

#: filetemplates.cpp:778
#, kde-format
msgid "Replace full name '%1' with the '%{fullname}' macro"
msgstr ""

#: filetemplates.cpp:783
#, kde-format
msgid "Replace email address '%1' with the '%email' macro"
msgstr ""

#: filetemplates.cpp:794
msgid "Create Template"
msgstr "Namuna yaratish"

#: filetemplates.cpp:795
msgid ""
"The template will now be created and saved to the chosen location. To "
"position the cursor put the string ${|} where you want it in files created "
"from the template."
msgstr ""

